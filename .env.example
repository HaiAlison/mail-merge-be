# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
WHITE_LIST=http://localhost:3003,https://yourdomain.com

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Trỏ đến PostgreSQL chạy trên host/managed service (KHÔNG phải trong Docker)
# Ví dụ: RDS endpoint, hoặc IP server chạy postgres native
DATABASE_HOST=your-db-host-or-ip
DATABASE_PORT=5432
DATABASE_NAME=mail-merge
DATABASE_USER=dzy
DATABASE_PASS=change_me_in_production

# ─── Redis ──────────────────────────────────────────────────────────────────
# Trỏ đến Redis chạy trên host/managed service (KHÔNG phải trong Docker)
# Ví dụ: ElastiCache endpoint, hoặc IP server chạy redis native
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth2 ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Frontend ───────────────────────────────────────────────────────────────
# Redirect URL after OAuth (query params: accessToken, refreshToken, userId, googleAccessToken)
FRONTEND_URL=http://localhost:3003

# ─── AWS S3 (file storage for attachments) ──────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-s3-bucket-name

